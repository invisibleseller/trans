{
  "name": "realtime-interp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:create": "wrangler d1 create realtime-interp-db",
    "db:migrate": "wrangler d1 execute realtime-interp-db --remote --file=./migrations/0001_init.sql",
    "db:migrate:local": "wrangler d1 execute realtime-interp-db --local --file=./migrations/0001_init.sql",
    "codes": "node scripts/gen-codes.mjs"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
